# PHANTOM — Environment Configuration Template
# Copy this file to .env to customize settings

# Application Name & Debug
APP_NAME="PHANTOM — The AI That Haunts Your Terminal"
DEBUG=false

# Ollama Local AI Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"
OLLAMA_TIMEOUT_SECONDS=120

# Scanner Safeguards & Boundaries
MAX_SCAN_FILES=2000
MAX_FILE_SIZE_BYTES=1048576

# Database Path (SQLite)
# DATABASE_PATH="backend/data/phantom.db"

# Visual Animation Atmosphere (high, low, off)
DEFAULT_ANIMATION_LEVEL="high"
